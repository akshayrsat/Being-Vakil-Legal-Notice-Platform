# Copy this file to .env if .env is missing.
# file:./dev.db means "a database file named dev.db inside the prisma folder".
DATABASE_URL="file:./dev.db"

# Staff door on the public site. Visitors of / stay on the customer page until this code is entered.
# Then sign-in stays open for about two hours (httpOnly cookie). At least 8 characters; use 12 or more.
# Set the real value on Cloud Run. Do not commit that value. This line is a placeholder only.
# Production refuses this exact placeholder, so a copied example does not open the door there.
NOTICE_DESK_ENTRY_CODE=replace-with-a-long-random-code

# Optional. Comma-separated Admin emails that may see template reference ids on the Templates page.
# Bank viewers and other firm staff see the template name and the channel. Leave commented to use the built-in owner addresses.
# OWNER_ADMIN_EMAILS=

# Optional. Leave commented to keep the practice password and dry-run sends.
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_MOBILE=
# The owner turns live send on or off in Settings. That choice overrides this line.
# Until someone saves a choice, the switch starts on. A key on its own does not send.
# MSG91_LIVE_SEND=true
# SMS Template ID from MSG91 SMS > Templates (hex id for Legal_Notice_12092026 / sender BVAKIL).
# MSG91_SMS_FLOW_ID=6abf5af2e9226c340a0548e2
# Must be the Template ID copied from MSG91 SMS > Templates (flow API can false-succeed on names). SMS wallet must be topped up.
# MSG91_SENDER_ID=BVAKIL
# MSG91_EMAIL_FROM=advocate@beingvakil.in
# MSG91_EMAIL_DOMAIN=beingvakil.in
# Email template_id must be the MSG91 slug (not numeric id 64975).
# Vars: contact_name, loan_account, notice_id (full HTTPS URL), notice_link, notice_code.
# HTML letterhead stays in email-notice.ts for previews. See MSG91_EMAIL.md for dashboard steps.
# MSG91_EMAIL_TEMPLATE_ID=legal_notice_non_payment
# WhatsApp sender. Live WhatsApp uses template legal_notice_link (en_US):
# body_1 customer name, body_2 bank name, button_1 notice path (notice-<id>)
# for https://www.notice.beingvakil.in/{{1}}
# The app does not read MSG91_WHATSAPP_TEMPLATE. If you document one, it must be legal_notice_link.
# MSG91_WHATSAPP_TEMPLATE=legal_notice_link
# MSG91_WHATSAPP_INTEGRATED_NUMBER=
# Optional. At least 8 characters. Leave commented and delivery callbacks are refused.
# MSG91_WEBHOOK_SECRET=

# Optional India Post tracking. Leave both commented to use manual status and CSV import.
# When both are set, Refresh on a consignment calls GET {base}/track/{article}
# with Authorization: Bearer {key}. The JSON must look like:
# { "status": "IN_TRANSIT", "events": [{ "status": "BOOKED", "note": "", "occurredAt": "2026-10-01T10:00:00.000Z" }] }
# INDIA_POST_API_BASE_URL=
# INDIA_POST_API_KEY=

# ODR (arbitration / mediation) is off until both of these are true:
# this line is exactly true, and the owner turns the ODR switch on in Settings.
# It does not change MSG91_LIVE_SEND or ordinary notice sending.
# ODR_LIVE_SEND=
# Google Meet. No key file. On Cloud Run the runtime account signs a JWT for this service account,
# which impersonates the mediator mailbox. Leave both commented on a laptop: hearings get a practice link.
# GOOGLE_MEET_SERVICE_ACCOUNT=notice-desk-meet@being-vakil-site-2026.iam.gserviceaccount.com
# GOOGLE_MEET_HOST_EMAIL=mediator@beingvakil.in
# At least 16 characters. Cloud Scheduler sends it as the header x-odr-cron-secret.
# ODR_CRON_SECRET=
# SMS stays unsent until a DLT flow id is set (header BVAKIL). Email and WhatsApp for the first
# arbitration hearing default to arbitration_first_hearing when these are left blank.
# ODR_SMS_FLOW_ID=
# ODR_SMS_SENDER_ID=BVAKIL
# ODR_EMAIL_TEMPLATE_ID=arbitration_first_hearing
# Morning list for each arbitrator, sent on the first cron run at or after 07:30 IST.
# The MSG91 template should print the variable schedule. Nothing is sent while ODR sending is off.
# ODR_SCHEDULE_EMAIL_TEMPLATE_ID=
# Domain-wide delegation for the mediator mailbox also needs
# https://www.googleapis.com/auth/meetings.space.settings
# so the hearing can be set to RESTRICTED and co-host can be attempted.
# Workspace Business Starter (the Base column) does not include co-hosts or waiting rooms.
# ODR_WHATSAPP_TEMPLATE=arbitration_first_hearing
# ODR_WHATSAPP_FROM=919653331393
# ODR_WHATSAPP_NAMESPACE=
# Later templates. Empty means that channel is not sent.
# ODR_NEXT_SMS_FLOW_ID=
# ODR_NEXT_EMAIL_TEMPLATE_ID=
# ODR_NEXT_WHATSAPP_TEMPLATE=
# ODR_REMINDER_SMS_FLOW_ID=
# ODR_REMINDER_EMAIL_TEMPLATE_ID=
# ODR_REMINDER_WHATSAPP_TEMPLATE=
# ODR_MEDIATION_SMS_FLOW_ID=
# ODR_MEDIATION_EMAIL_TEMPLATE_ID=
# ODR_MEDIATION_WHATSAPP_TEMPLATE=
# ODR_MEDIATION_NEXT_SMS_FLOW_ID=
# ODR_MEDIATION_NEXT_EMAIL_TEMPLATE_ID=
# ODR_MEDIATION_NEXT_WHATSAPP_TEMPLATE=
# ODR_MEDIATION_REMINDER_SMS_FLOW_ID=
# ODR_MEDIATION_REMINDER_EMAIL_TEMPLATE_ID=
# ODR_MEDIATION_REMINDER_WHATSAPP_TEMPLATE=

# Public host written into SMS notice links.
# Leave this commented on your computer. The site then uses http://localhost:4317.
# NOTICE_PUBLIC_BASE_URL=https://www.notice.beingvakil.in
