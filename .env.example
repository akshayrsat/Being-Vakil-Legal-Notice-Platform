# Copy this file to .env if .env is missing.
# file:./dev.db means "a database file named dev.db inside the prisma folder".
DATABASE_URL="file:./dev.db"

# Staff door on the public site. Visitors of / stay on the customer page until this code is entered.
# Then sign-in stays open for about two hours (httpOnly cookie). At least 8 characters; use 12 or more.
# Set the real value on Cloud Run. Do not commit that value. This line is a placeholder only.
# Production refuses this exact placeholder, so a copied example does not open the door there.
NOTICE_DESK_ENTRY_CODE=replace-with-a-long-random-code

# Optional. Leave commented to keep the practice password and dry-run sends.
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_MOBILE=
# MSG91_LIVE_SEND=true
# SMS Template ID from MSG91 SMS > Templates (hex id for Legal_Notice_12092026 / sender BVAKIL).
# MSG91_SMS_FLOW_ID=6abf5af2e9226c340a0548e2
# Must be the Template ID copied from MSG91 SMS > Templates (flow API can false-succeed on names). SMS wallet must be topped up.
# MSG91_SENDER_ID=BVAKIL
# MSG91_EMAIL_FROM=advocate@beingvakil.in
# MSG91_EMAIL_DOMAIN=beingvakil.in
# Email template_id must be the MSG91 slug (not numeric id 64975).
# Vars: contact_name, loan_account, notice_id (full HTTPS URL), notice_link, notice_code.
# HTML letterhead stays in email-notice.ts for previews. See MSG91_EMAIL.md for dashboard steps.
# MSG91_EMAIL_TEMPLATE_ID=legal_notice_non_payment
# WhatsApp sender. Live WhatsApp uses template legal_notice_link (en_US):
# body_1 customer name, body_2 bank name, button_1 notice path (notice-<id>)
# for https://www.notice.beingvakil.in/{{1}}
# MSG91_WHATSAPP_INTEGRATED_NUMBER=
# Optional. At least 8 characters. Leave commented and delivery callbacks are refused.
# MSG91_WEBHOOK_SECRET=

# Public host written into SMS notice links.
# Leave this commented on your computer. The site then uses http://localhost:4317.
# NOTICE_PUBLIC_BASE_URL=https://www.notice.beingvakil.in
