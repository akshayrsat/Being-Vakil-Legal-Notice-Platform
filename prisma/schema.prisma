// What this app stores.
// A bank is a client of the firm. Later notices and spreadsheets must belong to one bank.
// A user is a person who can sign in.
// A Bank Viewer is tied to one bank (bankId). An Admin is not tied to a bank.
// The Admin's selectedBankId is the bank they are working on right now.
// A session is one signed-in visit. Signing out deletes it.
// Allowed roles: OWNER, LEGAL_COORDINATOR, BANK_USER.
// ADMIN and BANK_VIEWER remain so an existing login still opens.

generator client {
  provider = "prisma-client-js"
}

// Local practice uses SQLite and `prisma db push` (see npm run dev).
// Files under prisma/migrations are PostgreSQL for Cloud SQL. Do not run them
// on the SQLite file: they use BOOLEAN and TIMESTAMP(3). The generated client
// follows this provider. Pointing a SQLite client at Postgres will not work.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BANK_VIEWER
  OWNER
  LEGAL_COORDINATOR
  BANK_USER
}

// Draft wording is not offered when filling a notice. Approved means the firm
// has marked it ready. This site does not ask a phone company to approve it.
enum TemplateStatus {
  DRAFT
  APPROVED
}

model Bank {
  id         String         @id @default(cuid())
  name       String
  code       String         @unique
  active     Boolean        @default(true)
  members    User[]         @relation("MemberBank")
  selectedBy User[]         @relation("SelectedBank")
  columnMap  BankColumnMap?
  batches    UploadBatch[]
  templates  NoticeTemplate[]
  campaigns  Campaign[]
  notices    PublicNotice[]
  consignments SpeedPostConsignment[]
  // When true, a live email also attaches a PDF of that notice. Default off.
  // The clickable notice link in the email is unchanged.
  attachNoticePdf Boolean    @default(false)
  createdAt  DateTime       @default(now())
}

// bankId is the bank this wording was written for.
// A draft is listed only for that bank. Approved wording is the firm library:
// every bank can select it. That share is the template text only.
// Spreadsheets, people, sends, deliveries, and notices stay on one bank.
// channels is a JSON list such as ["SMS","EMAIL"]. seedKey is set only for the MSG91 library templates.
model NoticeTemplate {
  id            String         @id @default(cuid())
  bankId        String
  bank          Bank           @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name          String
  dltTemplateId String         @default("")
  channels      String         @default("[]")
  body          String
  status        TemplateStatus @default(DRAFT)
  seedKey       String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  campaigns     Campaign[]

  @@index([bankId])
}

// The printed legal notice. Firm-wide: no bank.
// This is not the SMS, email, or WhatsApp message (those stay on NoticeTemplate).
// format "demand" is the notice the app already sends. format "text" is wording staff add.
// seedKey is set only for that starter notice.
model LegalNoticeTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  format    String   @default("text")
  seedKey   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The column match saved for one bank. The next spreadsheet for that bank starts from this.
model BankColumnMap {
  bankId    String   @id
  bank      Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  fields    String
  updatedAt DateTime @updatedAt
}

// One uploaded spreadsheet, kept under a single bank.
model UploadBatch {
  id          String          @id @default(cuid())
  bankId      String
  bank        Bank            @relation(fields: [bankId], references: [id], onDelete: Cascade)
  fileName    String
  headers     String
  rawRows     String
  mappingUsed String          @default("")
  saved       Boolean         @default(false)
  rowCount    Int             @default(0)
  createdAt   DateTime        @default(now())
  rows        RecipientRow[]
  campaigns   Campaign[]

  @@index([bankId])
}

// One notice recipient taken from a spreadsheet row, after the columns were matched.
model RecipientRow {
  id                String      @id @default(cuid())
  batchId           String
  batch             UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  bankId            String
  rowNumber         Int
  customerName      String
  mobile1           String      @default("")
  mobile2           String      @default("")
  mobile3           String      @default("")
  mobiles           String      @default("[]")
  email             String      @default("")
  address           String      @default("")
  loanNumber        String      @default("")
  customerId        String      @default("")
  loanAmount        String      @default("")
  outstandingAmount String      @default("")
  loanType          String      @default("")
  referenceNumber   String      @default("")
  collectionManager String      @default("")
  collectionManagerMobile String @default("")
  bankWebsite       String      @default("")
  coBorrowerName    String      @default("")
  coBorrowerMobile  String      @default("")
  coBorrowerEmail   String      @default("")
  guarantorName     String      @default("")
  guarantorMobile   String      @default("")
  guarantorEmail    String      @default("")

  @@index([bankId])
  @@index([batchId])
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           Role
  bankId         String?
  bank           Bank?     @relation("MemberBank", fields: [bankId], references: [id], onDelete: SetNull)
  selectedBankId String?
  selectedBank   Bank?     @relation("SelectedBank", fields: [selectedBankId], references: [id], onDelete: SetNull)
  sessions       Session[]
  challenges     LoginChallenge[]
  campaigns      Campaign[]
  createdAt      DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A short-lived step after the Admin password, used only when MSG91 OTP is configured.
// The one-time code itself is not stored here. MSG91 checks it.
model LoginChallenge {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobile    String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

enum CampaignMode {
  DRY_RUN
  LIVE
}

enum CampaignStatus {
  REVIEW
  COMPLETED
  FAILED
}

// PENDING is the review, before confirm.
// SIMULATED_SENT means a dry run. Nothing was handed to the operator.
// SENT is a live handoff to the operator. DELIVERED and READ come from a later receipt.
// SMS stays SENT until a delivery receipt. A dry run is never relabelled as delivered.
enum DeliveryStatus {
  PENDING
  SKIPPED
  QUEUED
  SIMULATED_SENT
  SENT
  DELIVERED
  READ
  FAILED
}

// One prepared send for one bank, one spreadsheet, and one approved template.
model Campaign {
  id            String             @id @default(cuid())
  bankId        String
  bank          Bank               @relation(fields: [bankId], references: [id], onDelete: Cascade)
  batchId       String
  batch         UploadBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  templateId    String
  template      NoticeTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateName  String
  templateBody  String
  dltTemplateId String             @default("")
  // Snapshot of the printed legal notice chosen for this send.
  // Empty on older sends, which keep the notice the app already used.
  legalNoticeTemplateId String     @default("")
  legalNoticeName       String     @default("")
  legalNoticeBody       String     @default("")
  legalNoticeFormat     String     @default("")
  channels      String
  mode          CampaignMode
  status        CampaignStatus     @default(REVIEW)
  dryRunNote    String             @default("")
  createdById   String?
  createdBy     User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  confirmedAt   DateTime?
  deliveries    CampaignDelivery[]
  followsCampaignId String?
  followsCampaign   Campaign?  @relation("FollowUp", fields: [followsCampaignId], references: [id], onDelete: SetNull)
  followUps         Campaign[] @relation("FollowUp")
  notices           PublicNotice[]
  consignments      SpeedPostConsignment[]

  @@index([bankId])
  @@index([followsCampaignId])
}

// One channel for one person. Kept so a later version can track and search deliveries.
model CampaignDelivery {
  id             String         @id @default(cuid())
  campaignId     String
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bankId         String
  recipientRowId String
  rowNumber      Int
  customerName   String
  mobile         String         @default("")
  email          String         @default("")
  loanNumber     String         @default("")
  customerId     String         @default("")
  channel        String
  status         DeliveryStatus
  detail         String         @default("")
  messageText    String         @default("")
  providerId     String         @default("")
  noticeNumber   String         @default("")
  // First MSG91 email open (or WhatsApp read). Null until the webhook reports it.
  openedAt       DateTime?

  @@index([campaignId])
  @@index([providerId])
  @@index([bankId])
  @@index([customerName])
  @@index([mobile])
  @@index([loanNumber])
  @@index([customerId])
}

// One recipient's public notice. The SMS link looks this up by noticeNumber.
// The fields are copied at prepare time, so a later spreadsheet edit does not change the page.
// seedKey is set only for the three practice notices.
model PublicNotice {
  id                String    @id @default(cuid())
  noticeNumber      String    @unique
  bankId            String
  bank              Bank      @relation(fields: [bankId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipientRowId    String    @default("")
  customerName      String
  address           String    @default("")
  loanAmount        String    @default("")
  outstandingAmount String    @default("")
  loanNumber        String    @default("")
  customerId        String    @default("")
  loanType          String    @default("")
  referenceNumber   String    @default("")
  collectionManager String    @default("")
  collectionManagerMobile String @default("")
  bankWebsite       String    @default("")
  bankName          String
  body              String
  // "" or "demand": draw the existing legal notice. "text": body is the filled template.
  documentFormat    String    @default("")
  seedKey           String?   @unique
  // First time the public notice page was opened (/notice-<id> and the other public routes).
  // This is the webpage view. It is not CampaignDelivery.openedAt (MSG91 email open or WhatsApp read).
  linkOpenedAt      DateTime?
  linkLastViewedAt  DateTime?
  linkViewCount     Int       @default(0)
  createdAt         DateTime  @default(now())
  consignments      SpeedPostConsignment[]

  @@index([bankId])
  @@index([campaignId])
  @@index([recipientRowId])
  @@index([loanNumber])
  @@index([customerId])
}

// One physical Speed Post booking for a person on a bank.
// Status history lives in SpeedPostEvent. articleNumber stays empty until staff enter it.
// Status is a string so SQLite and Cloud SQL Postgres share one migration shape.
model SpeedPostConsignment {
  id             String         @id @default(cuid())
  bankId         String
  bank           Bank           @relation(fields: [bankId], references: [id], onDelete: Cascade)
  publicNoticeId String?
  publicNotice   PublicNotice?  @relation(fields: [publicNoticeId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipientRowId String         @default("")
  customerName   String         @default("")
  loanNumber     String         @default("")
  customerId     String         @default("")
  noticeNumber   String         @default("")
  articleNumber  String         @default("")
  status         String         @default("BOOKED")
  note           String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         SpeedPostEvent[]

  @@index([bankId])
  @@index([articleNumber])
  @@index([loanNumber])
  @@index([customerId])
  @@index([noticeNumber])
  @@index([campaignId])
  @@index([publicNoticeId])
  @@index([recipientRowId])
  @@index([status])
}

model SpeedPostEvent {
  id            String               @id @default(cuid())
  consignmentId String
  consignment   SpeedPostConsignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  status        String
  note          String               @default("")
  occurredAt    DateTime             @default(now())
  source        String               @default("manual")
  createdAt     DateTime             @default(now())

  @@index([consignmentId])
  @@index([occurredAt])
}

// Firm-wide live send switch. One row, id "live-send".
// No row means the switch starts on, because production sending is on.
// After an admin saves, this row overrides MSG91_LIVE_SEND and survives a restart.
model LiveSendSetting {
  id        String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt
}

// Who did what. Firm staff can read this. A Bank Viewer cannot.
// The summary is a short sentence. Passwords, notice text, and MSG91 keys are not stored here.
model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  actorRole String
  action    String
  summary   String
  bankId    String?
  bankName  String   @default("")
  targetId  String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([bankId])
}
